{
  "name": "courseware-to-video-project",
  "version": "1.0.0",
  "description": "课件(3D 交互实验)转短视频讲解视频 (Remotion). Skill: courseware-to-video.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts build",
    "render": "remotion render src/index.ts CourseVideo out/course.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=1",
    "render:preview": "remotion render src/index.ts CourseVideo out/course-preview.mp4 --codec=h264 --crf=23 --scale=0.5 --concurrency=1",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.487",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.487"
  },
  "devDependencies": {
    "@types/node": "24.10.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
